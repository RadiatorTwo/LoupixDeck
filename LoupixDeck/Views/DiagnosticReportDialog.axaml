<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:LoupixDeck.Localization"
        xmlns:vm="using:LoupixDeck.ViewModels"
        mc:Ignorable="d"
        Width="820" Height="700"
        x:Class="LoupixDeck.Views.DiagnosticReportDialog"
        x:DataType="vm:DiagnosticReportViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Diagnostics_ReportTitle}"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Margin="24,20,24,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondary}"
                   Text="{loc:Tr Diagnostics_ReportPrivacyHint}" />

        <Border Grid.Row="1"
                Margin="24,0,24,0"
                Background="{DynamicResource AppSurfaceLow}"
                BorderBrush="{DynamicResource AppBorderSubtle}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Margin="16"
                                     FontFamily="Cascadia Mono,Menlo,DejaVu Sans Mono,monospace"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     Text="{Binding ReportText}" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Background="{DynamicResource AppSurfaceLow}"
                BorderBrush="{DynamicResource AppBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasStatus}"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Text="{Binding StatusText}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="{loc:Tr Diagnostics_CopyReport}"
                            Command="{Binding CopyCommand}" />
                    <Button Content="{loc:Tr Diagnostics_SaveReport}"
                            Command="{Binding SaveCommand}" />
                    <Button Content="{loc:Tr Diagnostics_Close}"
                            IsCancel="True"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
