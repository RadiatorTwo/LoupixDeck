<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LoupixDeck.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LoupixDeck.ViewModels"
        xmlns:controls="using:LoupixDeck.Views.Controls"
        mc:Ignorable="d"
        Width="560" Height="480" MinWidth="420" MinHeight="300"
        x:Class="LoupixDeck.Views.PluginReleaseNotesDialog"
        x:DataType="vm:PluginReleaseNotesViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr PluginStore_Title}"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Same flat action buttons as UpdateDialog. -->
        <Style Selector="Button.dialogBtn">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialogBtn.cancel">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        </Style>
        <Style Selector="Button.dialogBtn.cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppControlBackgroundHover}" />
        </Style>

        <Style Selector="Button.dialogBtn.confirm">
            <Setter Property="Background" Value="{StaticResource PageActiveBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>
        <Style Selector="Button.dialogBtn.confirm:pointerover">
            <Setter Property="Background" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="24,20,24,12">
            <TextBlock Text="{Binding Headline}"
                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextPrimary}" />
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondary}" />
        </StackPanel>

        <!-- No Padding on the ScrollViewer: the inset lives on the content margin. -->
        <Border Grid.Row="1" Margin="24,0,24,16"
                BorderBrush="{DynamicResource AppBorderSubtle}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
                <controls:MarkdownText Markdown="{Binding Notes}" Margin="14,10,14,10"
                                       TextElement.FontSize="13"
                                       TextElement.Foreground="{DynamicResource AppTextSecondary}" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceLow}"
                BorderBrush="{DynamicResource AppBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="dialogBtn cancel"
                        Content="{Binding DismissText}"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
                <!-- Hidden when the dialog is only showing the notes. -->
                <Button Classes="dialogBtn confirm"
                        Content="{Binding ConfirmText}"
                        IsDefault="True"
                        IsVisible="{Binding IsConfirmation}"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
