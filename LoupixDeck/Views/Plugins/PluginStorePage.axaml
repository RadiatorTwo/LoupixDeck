<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LoupixDeck.Localization"
             xmlns:vmp="using:LoupixDeck.ViewModels.Plugins"
             x:Class="LoupixDeck.Views.Plugins.PluginStorePage"
             x:DataType="vmp:PluginsWindowViewModel">

    <UserControl.Styles>
        <!-- The plugin a config asked for, when the store was opened for it. -->
        <Style Selector="Border.card.highlighted">
            <Setter Property="BorderBrush" Value="{StaticResource PageActiveBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24,16,24,16">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="page-title" Text="{loc:Tr PluginStore_Title}" />
            <Button Grid.Column="1" VerticalAlignment="Center"
                    Content="{loc:Tr PluginStore_Refresh}"
                    Command="{Binding PluginStore.RefreshCommand}" />
        </Grid>

        <TextBlock Classes="hint" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{loc:Tr PluginStore_Intro}" />

        <!-- The list is not what the server publishes right now: the offline copy, or one too old. -->
        <Border Classes="pill warn" HorizontalAlignment="Stretch" CornerRadius="6" Padding="12,8"
                Margin="0,0,20,8" IsVisible="{Binding PluginStore.HasStaleNotice}">
            <TextBlock TextWrapping="Wrap" FontSize="13" FontWeight="Normal"
                       Text="{Binding PluginStore.StaleNoticeText}" />
        </Border>

        <Border Classes="pill warn" HorizontalAlignment="Stretch" CornerRadius="6" Padding="12,8"
                Margin="0,0,20,12" IsVisible="{Binding PluginStore.HasNotice}">
            <TextBlock TextWrapping="Wrap" FontSize="13" FontWeight="Normal"
                       Text="{Binding PluginStore.NoticeText}" />
        </Border>

        <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                     IsVisible="{Binding PluginStore.IsLoading}" />

        <ItemsControl ItemsSource="{Binding PluginStore.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmp:PluginStoreRowViewModel">
                    <Border Classes="card" Classes.highlighted="{Binding IsHighlighted}">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Panel Grid.Column="0" Grid.RowSpan="2" Width="40" Height="40"
                                   Margin="0,0,14,0" VerticalAlignment="Top">
                                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                                <!-- mdi-puzzle -->
                                <TextBlock FontFamily="{StaticResource MdiFont}" Text="&#xF0431;"
                                           FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasIcon}" />
                            </Panel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="card-title" Margin="0" Text="{Binding Name}" />
                                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding VersionText}" />
                                </StackPanel>
                                <TextBlock Classes="hint" Text="{Binding Author}"
                                           IsVisible="{Binding Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding Description}"
                                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Spacing="8" Margin="12,0,0,0"
                                        HorizontalAlignment="Right">
                                <Border Classes="pill" HorizontalAlignment="Right"
                                        Classes.ok="{Binding IsStatusOk}"
                                        Classes.warn="{Binding IsStatusWarn}"
                                        Classes.neutral="{Binding IsStatusNeutral}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                            IsEnabled="{Binding IsIdle}">
                                    <Button Content="{loc:Tr PluginStore_Install}"
                                            IsVisible="{Binding CanInstall}"
                                            Command="{Binding $parent[Window].((vmp:PluginsWindowViewModel)DataContext).PluginStore.InstallCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{loc:Tr PluginStore_Update}"
                                            IsVisible="{Binding CanUpdate}"
                                            Command="{Binding $parent[Window].((vmp:PluginsWindowViewModel)DataContext).PluginStore.InstallCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{loc:Tr Settings_Remove}" Classes="danger"
                                            IsVisible="{Binding CanRemove}"
                                            Command="{Binding $parent[Window].((vmp:PluginsWindowViewModel)DataContext).PluginStore.RemoveCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                             IsVisible="{Binding IsBusy}" />
                                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding DetailText}"
                                           IsVisible="{Binding HasDetail}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{Binding PluginStore.StatusText}"
                   IsVisible="{Binding PluginStore.HasStatus}" />

        <TextBlock Classes="hint" Margin="0,8,0,0"
                   IsVisible="{Binding PluginStore.ShowRestartHint}"
                   Text="{loc:Tr Settings_SomeChangesFinishApplyingAfter}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
