<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LoupixDeck.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fp="using:LoupixDeck.ViewModels.FolderPanel"
        xmlns:views="using:LoupixDeck.Views"
        mc:Ignorable="d"
        x:Class="LoupixDeck.Views.FolderPanelWindow"
        x:DataType="fp:FolderPanelViewModel"
        Title="{loc:Tr FolderPanel_Title}"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="Manual"
        Width="296"
        Focusable="True"
        Background="{DynamicResource AppWindowBackground}">
    <Panel>
        <views:FolderPanelView Name="PanelView" />

        <!-- Drag feedback while the pointer is over this window: the ghost of the dragged folder and
             where a drop would put it in the tree. -->
        <Canvas Name="DragOverlay" IsHitTestVisible="False" IsVisible="False">
            <Border Name="DropIndicator" IsVisible="False" CornerRadius="4" />
            <Border Name="DragGhost"
                    IsVisible="False"
                    Opacity="0.7"
                    CornerRadius="6" ClipToBounds="True"
                    BorderThickness="3" BorderBrush="#FF3D9BFF"
                    Background="#FF202020">
                <Image Name="DragGhostImage" Stretch="Uniform" />
            </Border>
        </Canvas>
    </Panel>
</Window>
