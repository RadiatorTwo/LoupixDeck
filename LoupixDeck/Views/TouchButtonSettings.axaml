<Window
    x:Class="LoupixDeck.Views.TouchButtonSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LoupixDeck.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ccp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
    xmlns:local="clr-namespace:LoupixDeck"
    xmlns:vm="using:LoupixDeck.ViewModels"
    xmlns:views="using:LoupixDeck.Views"
    xmlns:layers="clr-namespace:LoupixDeck.Models.Layers"
    xmlns:conv="clr-namespace:LoupixDeck.Models.Converter"
    xmlns:models="clr-namespace:LoupixDeck.Models"
    x:DataType="vm:TouchButtonSettingsViewModel"
    Title="{Binding ButtonLabel}"
    Width="1440"
    Height="1160"
    MinWidth="1100"
    MinHeight="820"
    MaxHeight="1240"
    mc:Ignorable="d"
    CanResize="True">

    <Window.Resources>
        <conv:TransitionKindLabelConverter x:Key="TransitionKindLabel" />
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />

        <!-- Wrapped, left → top-to-bottom execution order, shared by all sequence strips. -->
        <ItemsPanelTemplate x:Key="ChipPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- One chip per chained command. Shared by every sequence strip; the event
             handlers resolve their owning strip/slot from the visual tree. -->
        <DataTemplate x:Key="CommandChipTemplate" DataType="{x:Type vm:CommandSegment}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Panel Width="22">
                    <TextBlock Classes="sequence-arrow" Text="&#x2192;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowConnector}" />
                </Panel>
                <Border Classes="command-chip"
                        Classes.dragging="{Binding IsDragging}"
                        ToolTip.Tip="{Binding DisplayName}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Classes="drag-handle chip-grip"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Tr TouchButton_DragToReorder}"
                                PointerPressed="CommandDragHandle_PointerPressed">
                            <TextBlock Text="&#xF01DB;" />
                        </Border>

                        <Border Grid.Column="1" Classes="chip-index"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Position}" />
                        </Border>

                        <TextBlock Grid.Column="2" Classes="chip-title"
                                   Text="{Binding DisplayName}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="3" Classes="chip-action"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MdiFont}"
                                Content="&#xF0140;"
                                ToolTip.Tip="{loc:Tr TouchButton_EditParameters}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Panel Width="300">
                                        <StackPanel Spacing="4" IsVisible="{Binding IsKnown}">
                                            <ItemsControl ItemsSource="{Binding Parameters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CommandParameter}">
                                                        <Grid ColumnDefinitions="120,*" Margin="0,0,0,4">
                                                            <TextBlock Grid.Column="0"
                                                                       Classes="editor-label"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Value, Mode=TwoWay}"
                                                                     IsVisible="{Binding IsText}">
                                                                <TextBox.InnerRightContent>
                                                                    <!-- Record the value by pressing the keys instead of typing their names. -->
                                                                    <Button Classes="chip-action"
                                                                            Margin="0,0,4,0"
                                                                            FontFamily="{StaticResource MdiFont}"
                                                                            Content="&#xF030C;"
                                                                            IsVisible="{Binding HasPicker}"
                                                                            Command="{Binding PickCommand}"
                                                                            ToolTip.Tip="{Binding PickerHint}" />
                                                                </TextBox.InnerRightContent>
                                                            </TextBox>
                                                            <ComboBox Grid.Column="1"
                                                                      HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Value, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsEnum}" />
                                                            <CheckBox Grid.Column="1"
                                                                      IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsBool}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="hint"
                                                       Text="{loc:Tr TouchButton_ThisCommandHasNoParameters}"
                                                       IsVisible="{Binding !Parameters.Count}" />
                                        </StackPanel>

                                        <Grid ColumnDefinitions="120,*" IsVisible="{Binding !IsKnown}">
                                            <TextBlock Grid.Column="0"
                                                       Classes="editor-label"
                                                       Text="{loc:Tr TouchButton_Command}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ShellText, Mode=TwoWay}" />
                                        </Grid>
                                    </Panel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="4" Classes="chip-action danger"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MdiFont}"
                                Content="&#xF01B4;"
                                ToolTip.Tip="{loc:Tr TouchButton_RemoveCommand}"
                                Click="RemoveCommand_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- One sequence strip per slot (1 for a normal button, 3 for FreeDraw segments).
             Click anywhere on a strip to make it the double-click-append target. -->
        <DataTemplate x:Key="SequenceStripTemplate" DataType="{x:Type vm:CommandSequenceSlot}">
            <Border Classes="sequence-strip"
                    Classes.active="{Binding IsActive}"
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Classes="hint"
                                   Text="{loc:TrFormat Common_CommandCountFmt, Commands.Count}" />
                    </StackPanel>

                    <Panel Grid.Column="1" MinHeight="40">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="320">
                            <ItemsControl Tag="chips"
                                          Loaded="SlotChipList_Loaded"
                                          ItemsSource="{Binding Commands}"
                                          VerticalAlignment="Top"
                                          ItemsPanel="{StaticResource ChipPanel}"
                                          ItemTemplate="{StaticResource CommandChipTemplate}"
                                          PointerMoved="CommandList_PointerMoved"
                                          PointerReleased="CommandList_PointerReleased"
                                          PointerCaptureLost="CommandList_PointerCaptureLost" />
                        </ScrollViewer>
                        <TextBlock Classes="hint" VerticalAlignment="Center"
                                   Text="{loc:Tr TouchButton_EmptyClickThisStripThen}"
                                   IsVisible="{Binding !Commands.Count}" />
                    </Panel>

                    <Button Grid.Column="2" Content="{loc:Tr TouchButton_Clear}"
                            Command="{Binding ClearCommandCommand}"
                            IsEnabled="{Binding HasCommand}"
                            VerticalAlignment="Top"
                            Margin="16,0,0,0" MinWidth="80"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="{loc:Tr TouchButton_RemoveAllCommandsInThis}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://LoupixDeck/Views/Styles/SettingsStyles.axaml" />

        <!-- Highlights the sequence strip that double-click-to-append targets. -->
        <Style Selector="Border.sequence-strip.active">
            <Setter Property="BorderBrush" Value="#FF66AAFF" />
            <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}" />
        </Style>

        <!-- Selection resize handle — size must match TouchButtonSettingsViewModel.HandleSize. -->
        <Style Selector="Rectangle.handle">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="#FF5B9BD5" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

    </Window.Styles>

    <!-- The top area takes whatever height is left over after the bottom sequence, so the
         dialog can be resized freely. The window's start height is clamped to the screen in
         code-behind (OnOpened) so the whole dialog fits without an outer scrollbar. -->
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Margin="12">

        <!-- ===== Main area: left panel / preview / properties ===== -->
        <!-- The right tab panel (Properties / Commands) is a fixed 550 px so its command
             picker ends up at least as wide as the Rotary editor's (measured: 484 px of
             picker vs. the rotary editor's 480 — 550 minus 12 tab margin, tab chrome,
             4 panel margin and 24 panel padding).
             The center preview takes the remaining width; it no longer needs the space,
             because the canvas is now sized to the frame plus a bleed instead of a fixed
             600×600 square. -->
        <Grid Grid.Row="0" ColumnDefinitions="290,*,550">

            <!-- Left: button settings + states + layer list -->
            <Border Grid.Column="0" Classes="editor-panel" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                    <StackPanel Grid.Row="0">
                        <!-- Side-strip (Razer) mode picker — only when editing a strip
                             canvas. Segmented locks the canvas (the strip shows the dial
                             labels); FreeDraw unlocks layer editing. -->
                        <StackPanel IsVisible="{Binding IsStripCanvas}" Margin="0,0,0,12">
                            <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_SideStrip}" />
                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Mode}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding AvailableStripModes}"
                                      SelectedItem="{Binding StripMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:Tr TouchButton_SwitchToFreeDrawToEdit}"
                                       IsVisible="{Binding IsDrawDisabledHintVisible}" />

                            <!-- Provider picker — only in PluginOverride mode. The plugin
                                 renders this strip and handles its taps/swipes. -->
                            <StackPanel IsVisible="{Binding IsPluginOverride}" Margin="0,8,0,0">
                                <TextBlock Classes="label" Text="{loc:Tr TouchButton_Provider}" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding AvailableStripProviders}"
                                          SelectedItem="{Binding SelectedStripProvider, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Title}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="{loc:Tr TouchButton_TheSelectedPluginRendersThis}" />
                            </StackPanel>

                            <!-- FreeDraw splits the strip into three vertical tap zones; each
                                 zone has its own command sequence (shown at the bottom). -->
                            <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding IsSegmentCommandMode}"
                                       Text="{loc:Tr TouchButton_ThisStripHasThreeTap}" />

                            <Separator Margin="0,12,0,0" />
                        </StackPanel>

                        <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_Button}" />
                        <!-- Sets the launch command and the icon in one step; it configures the
                             whole button, not a single layer, so it sits here rather than in the
                             Layers toolbar. -->
                        <Button Classes="toolbar accent" Content="{loc:Tr TouchButton_AssignApplication}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Command="{Binding AssignApplicationCommand}"
                                ToolTip.Tip="{loc:Tr TouchButton_PickAnInstalledApplicationSets}" />
                        <CheckBox Content="{loc:Tr TouchButton_RunWhileDeviceIsOff}"
                                  IsChecked="{Binding ButtonData.EnableWhenOff}"
                                  Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Tr TouchButton_VibrationEnabled}"
                                  IsChecked="{Binding ButtonData.VibrationEnabled}"
                                  IsVisible="{Binding IsVibrationSupported}"
                                  Margin="0,0,0,4" />
                        <StackPanel IsEnabled="{Binding ButtonData.VibrationEnabled}"
                                    IsVisible="{Binding IsVibrationSupported}">
                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Pattern}" Margin="0,2,0,2" />
                            <ComboBox ItemsSource="{Binding VibrationPatterns}"
                                      SelectedItem="{Binding SelectedVibrationPattern}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,12,0,12" />

                    <!-- States: compact state management, between Button and Layers. Mirrors the
                         Layers section's button sizes/layout. Fixed-height list (does not grow with
                         entries). Grid-touch buttons only; no popups, no horizontal list. -->
                    <StackPanel Grid.Row="2" IsVisible="{Binding ShowStatesSection}">
                        <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_States}" />

                        <UniformGrid Columns="2" Margin="0,0,0,8" IsEnabled="{Binding CanEditStates}">
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Add}" Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddStateCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_AddANewState}" />
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Duplicate}" Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DuplicateStateCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_DuplicateTheSelectedState}" />
                        </UniformGrid>

                        <!-- Fixed, compact height — kept smaller than the Layers list below. -->
                        <ListBox Height="108"
                                 ItemsSource="{Binding States}"
                                 SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                                 Background="{DynamicResource AppSurfaceLow}"
                                 CornerRadius="6">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="MinHeight" Value="32" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:ButtonState">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayIndex}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AppTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <Border Grid.Column="2" Classes="layer-badge"
                                                IsVisible="{Binding IsDefault}"
                                                ToolTip.Tip="{loc:Tr TouchButton_DefaultState}">
                                            <TextBlock Text="{loc:Tr TouchButton_Default}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanEditStates}">
                            <Button Classes="row-action" Content="▲"
                                    Command="{Binding MoveStateUpCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_MoveStateUp}" />
                            <Button Classes="row-action" Content="▼"
                                    Command="{Binding MoveStateDownCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_MoveStateDown}" />
                            <Button Classes="row-action"
                                    Command="{Binding SetDefaultStateCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_SetAsDefaultState}">
                                <TextBlock Text="&#xF04CE;" FontFamily="{StaticResource MdiFont}" />
                            </Button>
                            <Button Classes="row-action danger"
                                    Command="{Binding DeleteStateCommand}"
                                    IsEnabled="{Binding CanDeleteState}"
                                    ToolTip.Tip="{loc:Tr TouchButton_DeleteTheSelectedState}">
                                <TextBlock Text="&#xF01B4;" FontFamily="{StaticResource MdiFont}" />
                            </Button>
                        </StackPanel>

                        <TextBlock Classes="label" Margin="0,8,0,0"
                                   Text="{loc:TrFormat TouchButton_SelectedStateFmt, SelectedState.Name}" />

                        <!-- The assigned command owns these states: it created them and its plugin
                             decides which one is active. Only the layers inside a state stay editable. -->
                        <TextBlock Classes="label" Margin="0,8,0,0" TextWrapping="Wrap"
                                   IsVisible="{Binding AreStatesLocked}"
                                   Text="{loc:Tr TouchButton_StatesAreManagedByThe}" />

                        <StackPanel IsEnabled="{Binding CanEditStates}">
                            <CheckBox Content="{loc:Tr TouchButton_ResetToDefaultOnPage}"
                                      IsChecked="{Binding ResetOnPageChange, Mode=TwoWay}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="{loc:Tr TouchButton_ResetToDefaultOnRestart}"
                                      IsChecked="{Binding ResetOnRestart, Mode=TwoWay}"
                                      Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="3" Margin="0,12,0,12"
                               IsVisible="{Binding ShowStatesSection}" />

                    <StackPanel Grid.Row="4" IsEnabled="{Binding CanEditCanvas}">
                        <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_Layers}" />
                        <!-- 2×2 grid so all four add-layer buttons fit the fixed-width panel
                             regardless of label length (a single row overflowed the right edge). -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Text}" Margin="0,0,4,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddTextLayerCommand}" />
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Image}" Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddImageLayerCommand}" />
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Animation}" Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddAnimatedImageLayerCommand}" />
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Symbol}" Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddSymbolLayerCommand}" />
                        </UniformGrid>
                    </StackPanel>

                    <ListBox Grid.Row="5"
                             IsEnabled="{Binding CanEditCanvas}"
                             ItemsSource="{Binding ButtonData.Layers}"
                             SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                             Background="{DynamicResource AppSurfaceLow}"
                             CornerRadius="6">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="layers:TextLayer">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Visible, Mode=TwoWay}"
                                              MinWidth="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{loc:Tr TouchButton_LayerVisibility}" />
                                    <Border Grid.Column="1" Classes="layer-badge">
                                        <TextBlock Text="T" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Grid.Column="3" Text="&#xF033E;"
                                               FontFamily="{StaticResource MdiFont}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsVisible="{Binding IsCommandOwned}"
                                               ToolTip.Tip="{loc:TrFormat TouchButton_TextSuppliedByFmt, CommandName}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="layers:ImageLayer">
                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Visible, Mode=TwoWay}"
                                              MinWidth="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{loc:Tr TouchButton_LayerVisibility}" />
                                    <Border Grid.Column="1" Classes="layer-badge">
                                        <TextBlock Text="I" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="layers:SymbolLayer">
                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Visible, Mode=TwoWay}"
                                              MinWidth="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{loc:Tr TouchButton_LayerVisibility}" />
                                    <Border Grid.Column="1" Classes="layer-badge">
                                        <TextBlock Text="S" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                            <!-- Plugin-owned layer: rendered by a plugin command, not user-addable. -->
                            <DataTemplate DataType="layers:PluginLayer">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Visible, Mode=TwoWay}"
                                              MinWidth="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{loc:Tr TouchButton_LayerVisibility}" />
                                    <Border Grid.Column="1" Classes="layer-badge">
                                        <TextBlock Text="P" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding CommandName}" />
                                    <TextBlock Grid.Column="3" Text="&#xF033E;"
                                               FontFamily="{StaticResource MdiFont}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               ToolTip.Tip="{loc:Tr TouchButton_ContentRenderedByAPlugin}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0"
                                IsEnabled="{Binding CanEditCanvas}">
                        <Button Classes="row-action" Content="▲"
                                Command="{Binding MoveLayerUpCommand}"
                                ToolTip.Tip="{loc:Tr TouchButton_MoveLayerUp}" />
                        <Button Classes="row-action" Content="▼"
                                Command="{Binding MoveLayerDownCommand}"
                                ToolTip.Tip="{loc:Tr TouchButton_MoveLayerDown}" />
                        <Button Classes="row-action danger"
                                Command="{Binding RemoveLayerCommand}"
                                IsEnabled="{Binding CanDeleteSelectedLayer}"
                                ToolTip.Tip="{loc:Tr TouchButton_RemoveLayerPluginOwnedLayers}">
                            <TextBlock Text="&#xF01B4;" FontFamily="{StaticResource MdiFont}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center: Preview panel with editor canvas + selection overlay -->
            <Border Grid.Column="1" Classes="editor-panel" Padding="8">
                <Grid RowDefinitions="Auto,*">

                    <!-- Preview header + (placeholder) view toolbar -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                        <!-- A Grid, not a StackPanel: a horizontal StackPanel measures its
                             children unconstrained, so a longer translation ran under the
                             toolbar instead of shortening. The star column bounds the state
                             text, which then trims. -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Classes="panel-title" Text="{loc:Tr TouchButton_Preview}"
                                       Margin="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="label" VerticalAlignment="Center"
                                       Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding ShowStatesSection}"
                                       ToolTip.Tip="{loc:TrFormat TouchButton_EditingStateFmt, SelectedState.Name}"
                                       Text="{loc:TrFormat TouchButton_EditingStateFmt, SelectedState.Name}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="toolbar" Content="&#x2212;"
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_ZoomOut}" />
                            <TextBlock Text="{Binding ZoomPercentText}"
                                       VerticalAlignment="Center" MinWidth="42"
                                       TextAlignment="Center"
                                       ToolTip.Tip="{loc:Tr TouchButton_CurrentZoom}" />
                            <Button Classes="toolbar" Content="+"
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_ZoomIn}" />
                            <Button Classes="toolbar" Content="{loc:Tr TouchButton_Fit}"
                                    Command="{Binding FitCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_FitTheCanvasToThe}" />
                            <Button Classes="toolbar" Content="100%"
                                    Command="{Binding ResetZoomCommand}"
                                    ToolTip.Tip="{loc:Tr TouchButton_ResetZoomTo100}" />
                            <ToggleButton Classes="toolbar" Content="{loc:Tr TouchButton_Grid}"
                                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Tr TouchButton_ToggleAlignmentGrid}" />
                            <ToggleButton Classes="toolbar" Content="{loc:Tr TouchButton_Snap}"
                                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Tr TouchButton_SnapLayersToTheGrid}" />
                        </StackPanel>
                    </Grid>

                    <!-- Canvas area: lighter than the app chrome so black buttons stay
                         visible; the Skia preview is transparent outside the frame. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource AppEditorCanvasBackground}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Zoomable preview: a ScrollViewer pans when the canvas is
                                 scaled past the viewport; the LayoutTransform scales the plate
                                 + editor together. Using LayoutTransform (not RenderTransform)
                                 keeps the children's local 600×600 coordinate space, so the
                                 pointer math in the code-behind needs no zoom adjustment. -->
                            <ScrollViewer Name="PreviewScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <LayoutTransformControl HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomFactor}"
                                                        ScaleY="{Binding ZoomFactor}" />
                                    </LayoutTransformControl.LayoutTransform>

                                    <!-- The canvas is the device frame plus a fixed bleed on every
                                         side (EditorCanvasBleed) — no longer a 600×600 square, which
                                         left wide dead bars beside the frame and ate the width the
                                         command picker needs. -->
                                    <Grid Width="{Binding EditorCanvasWidth}"
                                          Height="{Binding EditorCanvasHeight}">
                                        <!-- Button plate: border + shadow behind the rendered
                                             frame. Sized to the aspect-correct frame so non-square
                                             canvases (e.g. 60×270 side strips) get a matching plate. -->
                                        <Border Width="{Binding FrameWidth}" Height="{Binding FrameHeight}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BorderBrush="#55000000" BorderThickness="1"
                                                BoxShadow="0 3 16 0 #50000000"
                                                IsHitTestVisible="False" />

                                        <Grid Name="EditorRoot"
                                              Width="{Binding EditorCanvasWidth}"
                                              Height="{Binding EditorCanvasHeight}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Background="Transparent"
                                              IsEnabled="{Binding CanEditCanvas}"
                                              PointerPressed="Editor_PointerPressed"
                                              PointerMoved="Editor_PointerMoved"
                                              PointerReleased="Editor_PointerReleased">
                                <Image Width="{Binding EditorCanvasWidth}"
                                       Height="{Binding EditorCanvasHeight}"
                                       Stretch="None"
                                       IsHitTestVisible="False"
                                       Source="{Binding EditorPreview, Converter={StaticResource SkiaToBitmapConverter}}" />
                                <Canvas Width="{Binding EditorCanvasWidth}"
                                        Height="{Binding EditorCanvasHeight}" Background="Transparent">
                                    <Rectangle Stroke="#CC5B9BD5"
                                               StrokeThickness="1"
                                               StrokeDashArray="4,3"
                                               Fill="Transparent"
                                               IsHitTestVisible="False"
                                               IsVisible="{Binding SelectionVisible}"
                                               Width="{Binding SelectionWidth}"
                                               Height="{Binding SelectionHeight}"
                                               Canvas.Left="{Binding SelectionLeft}"
                                               Canvas.Top="{Binding SelectionTop}" />
                                    <Rectangle Tag="NW" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleNwLeft}" Canvas.Top="{Binding HandleNwTop}" />
                                    <Rectangle Tag="N" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleNLeft}" Canvas.Top="{Binding HandleNTop}" />
                                    <Rectangle Tag="NE" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleNeLeft}" Canvas.Top="{Binding HandleNeTop}" />
                                    <Rectangle Tag="W" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleWLeft}" Canvas.Top="{Binding HandleWTop}" />
                                    <Rectangle Tag="E" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleELeft}" Canvas.Top="{Binding HandleETop}" />
                                    <Rectangle Tag="SW" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleSwLeft}" Canvas.Top="{Binding HandleSwTop}" />
                                    <Rectangle Tag="S" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleSLeft}" Canvas.Top="{Binding HandleSTop}" />
                                    <Rectangle Tag="SE" Classes="handle"
                                               IsVisible="{Binding ScaleHandlesVisible}"
                                               Canvas.Left="{Binding HandleSeLeft}" Canvas.Top="{Binding HandleSeTop}" />
                                </Canvas>
                                        </Grid>
                                    </Grid>
                                </LayoutTransformControl>
                            </ScrollViewer>

                            <!-- Locked overlay: shown while a side strip is in Segmented
                                 mode, where the canvas must not be edited. Swallows
                                 pointer input as a backstop (EditorRoot is also disabled). -->
                            <Border IsVisible="{Binding IsDrawDisabledHintVisible}"
                                    Background="#AA101010" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="&#xF033E;" FontFamily="{StaticResource MdiFont}"
                                               FontSize="34" Foreground="#E0FFFFFF"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr TouchButton_CanvasLocked}"
                                               Foreground="#E0FFFFFF" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr TouchButton_ThisStripIsnTIn}"
                                               Foreground="#B0FFFFFF" FontSize="11"
                                               TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Resolution badge -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,10,10"
                                    Background="#66000000" CornerRadius="4"
                                    Padding="8,3"
                                    IsHitTestVisible="False">
                                <TextBlock Text="{Binding CanvasSizeText}"
                                           Foreground="#E0FFFFFF" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Tabs (Properties / Commands) -->
            <TabControl Grid.Column="2" Name="RightTabs" Margin="12,0,0,0">
                <TabItem Header="{loc:Tr TouchButton_Properties}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,4,0" Spacing="12">

                            <!-- Button-wide settings -->
                            <Border Classes="editor-panel" IsEnabled="{Binding CanEditCanvas}">
                                <StackPanel>
                                    <TextBlock Classes="panel-title"
                                               Text="{loc:TrFormat TouchButton_ButtonNumberFmt, ButtonNumber}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Grid.Column="0" Content="{loc:Tr TouchButton_Background}" Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding BackgroundEnabled, Mode=TwoWay}"
                                                  ToolTip.Tip="{loc:Tr TouchButton_DrawsTheSelectedStateS}" />
                                        <ccp:ColorPicker Grid.Column="1"
                                                         Color="{Binding ButtonData.BackColor}"
                                                         IsEnabled="{Binding BackgroundEnabled}"
                                                         Width="110" HorizontalAlignment="Left"
                                                         ToolTip.Tip="{loc:Tr TouchButton_BackgroundColorOfTheSelected}" />
                                        <Button Grid.Column="2" Content="{loc:Tr TouchButton_Reset}"
                                                Click="ResetButton_Click"
                                                Background="#A03030" Foreground="White"
                                                ToolTip.Tip="{loc:Tr TouchButton_ClearsLayersColorsAndThe}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Selected state: rename. Shown when the state itself is the editing
                                 context (no layer selected); mutually exclusive with layer props. -->
                            <Border Classes="editor-panel" IsVisible="{Binding ShowStateProperties}">
                                <StackPanel>
                                    <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_State}" />
                                    <TextBlock Classes="label" Text="{loc:Tr TouchButton_Name}" />
                                    <TextBox Text="{Binding SelectedState.Name, Mode=TwoWay}"
                                             IsEnabled="{Binding CanEditStates}"
                                             Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Per-layer panel — shown only when a layer is selected
                                 (mutually exclusive with the State properties panel above). -->
                            <Border Classes="editor-panel" IsVisible="{Binding HasSelectedLayer}">
                                <StackPanel>
                                    <ContentControl Content="{Binding SelectedLayer}">
                                <ContentControl.DataTemplates>

                                    <!-- Image layer -->
                                    <DataTemplate DataType="layers:ImageLayer">
                                        <StackPanel>
                                            <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_SelectedLayerImage}" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Name}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="0,2,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Asset}" />
                                            <TextBlock Text="{Binding AssetRelativePath}"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Position}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding PositionX, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding PositionY, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_SizePx}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding DisplayWidth, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="H" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding DisplayHeight, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_CropSourceRect}" Margin="0,4,0,0"
                                                       ToolTip.Tip="{loc:Tr TouchButton_HoldAltDragAHandle}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*"
                                                  RowDefinitions="Auto,Auto" Margin="0,2,0,4">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="L" VerticalAlignment="Center" Margin="0,0,6,4" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                                               Value="{Binding SourceRect.Left, Mode=TwoWay}"
                                                               Minimum="0" />
                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="T" VerticalAlignment="Center" Margin="0,0,6,4" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="4" Margin="0,0,0,4"
                                                               Value="{Binding SourceRect.Top, Mode=TwoWay}"
                                                               Minimum="0" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="R" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                               Value="{Binding SourceRect.Right, Mode=TwoWay}"
                                                               Minimum="0" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="4"
                                                               Value="{Binding SourceRect.Bottom, Mode=TwoWay}"
                                                               Minimum="0" />
                                            </Grid>
                                            <TextBlock Classes="hint"
                                                       Text="{loc:Tr TouchButton_AllZerosUseFullImage}" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Text layer -->
                                    <DataTemplate DataType="layers:TextLayer">
                                        <StackPanel>
                                            <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_SelectedLayerText}" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Name}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="0,2,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Text2}" />
                                            <TextBox Text="{Binding Text, Mode=TwoWay}" Margin="0,2,0,2"
                                                     IsReadOnly="{Binding IsCommandOwned}" />
                                            <TextBlock Classes="hint" Margin="0,0,0,8"
                                                       IsVisible="{Binding IsCommandOwned}"
                                                       Text="{loc:TrFormat TouchButton_TextSuppliedByFmt, CommandName}" />

                                            <Grid ColumnDefinitions="*,12,*"
                                                  RowDefinitions="Auto,Auto"
                                                  Margin="0,0,0,8">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Classes="label" Text="{loc:Tr TouchButton_Size}" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="0"
                                                               Value="{Binding TextSize, Mode=TwoWay}"
                                                               Minimum="4" Maximum="80"
                                                               Increment="1" FormatString="0"
                                                               Height="32"
                                                               Margin="0,2,0,0" />
                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                           Classes="label" Text="{loc:Tr TouchButton_Color}" />
                                                <!-- Explicit pixel width: theme Width=64 is copied onto the
                                                     inner DropDownButton; NaN collapses the swatch. -->
                                                <Panel Grid.Row="1" Grid.Column="2" Margin="0,2,0,0">
                                                    <ccp:ColorPicker Color="{Binding TextColor, Mode=TwoWay}"
                                                                     Height="32"
                                                                     Width="{Binding $parent[Panel].Bounds.Width}" />
                                                </Panel>
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Style}" />
                                            <WrapPanel Margin="0,2,0,4">
                                                <CheckBox Content="{loc:Tr TouchButton_Bold}" IsChecked="{Binding Bold, Mode=TwoWay}"
                                                          Margin="0,0,12,0" />
                                                <CheckBox Content="{loc:Tr TouchButton_Italic}" IsChecked="{Binding Italic, Mode=TwoWay}"
                                                          Margin="0,0,12,0" />
                                                <CheckBox Content="{loc:Tr TouchButton_CenterInBox}" IsChecked="{Binding Centered, Mode=TwoWay}"
                                                          ToolTip.Tip="{loc:Tr TouchButton_CentersTheTextInsideIts}" />
                                            </WrapPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox Content="{loc:Tr TouchButton_Outline}" IsChecked="{Binding Outlined, Mode=TwoWay}"
                                                          Margin="0,0,10,0" />
                                                <ccp:ColorPicker Color="{Binding OutlineColor, Mode=TwoWay}"
                                                                 Width="80"
                                                                 IsVisible="{Binding Outlined}" />
                                            </StackPanel>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Position}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding PositionX, Mode=TwoWay}"
                                                               Minimum="-100" Maximum="100"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding PositionY, Mode=TwoWay}"
                                                               Minimum="-100" Maximum="100"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_BoxSize}"
                                                       ToolTip.Tip="{loc:Tr TouchButton_LayoutAreaForTheText}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,0">
                                                <TextBlock Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding BoxWidth, Mode=TwoWay}"
                                                               Minimum="10" Maximum="400"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="H" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding BoxHeight, Mode=TwoWay}"
                                                               Minimum="10" Maximum="400"
                                                               Increment="1" FormatString="0" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Symbol layer -->
                                    <DataTemplate DataType="layers:SymbolLayer">
                                        <StackPanel>
                                            <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_SelectedLayerSymbol}" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Name}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="0,2,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Symbol2}" />
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                <Border Grid.Column="0"
                                                        Width="48" Height="48"
                                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderSubtle}"
                                                        Background="{DynamicResource AppSurfaceLow}"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="{StaticResource MdiFont}"
                                                               FontSize="28"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Tr TouchButton_ChangeSymbol}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Click="ChangeSymbol_Click" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                <TextBlock Classes="label" Text="{loc:Tr TouchButton_Tint}" Width="60" VerticalAlignment="Center" />
                                                <ccp:ColorPicker Color="{Binding Tint, Mode=TwoWay}" Width="80" />
                                            </StackPanel>

                                            <Separator Margin="0,6,0,6" />
                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Style}" Margin="0,0,0,4" />

                                            <!-- Gradient fill -->
                                            <CheckBox Content="{loc:Tr TouchButton_GradientFill}"
                                                      IsChecked="{Binding UseGradient, Mode=TwoWay}" />
                                            <StackPanel IsVisible="{Binding UseGradient}" Margin="16,2,0,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="{loc:Tr TouchButton_From}" Width="50" VerticalAlignment="Center" />
                                                    <ccp:ColorPicker Color="{Binding GradientStartColor, Mode=TwoWay}" Width="80" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="{loc:Tr TouchButton_To}" Width="50" VerticalAlignment="Center" />
                                                    <ccp:ColorPicker Color="{Binding GradientEndColor, Mode=TwoWay}" Width="80" />
                                                </StackPanel>
                                                <TextBlock Text="{loc:Tr TouchButton_Angle}" />
                                                <Grid ColumnDefinitions="*,50">
                                                    <Slider Grid.Column="0"
                                                            Minimum="0" Maximum="360"
                                                            Value="{Binding GradientAngle, Mode=TwoWay}"
                                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GradientAngle, StringFormat={}{0:0}°}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Outline -->
                                            <CheckBox Content="{loc:Tr TouchButton_Outline}"
                                                      IsChecked="{Binding Outlined, Mode=TwoWay}"
                                                      Margin="0,2,0,0" />
                                            <StackPanel IsVisible="{Binding Outlined}" Margin="16,2,0,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="{loc:Tr TouchButton_Color2}" Width="50" VerticalAlignment="Center" />
                                                    <ccp:ColorPicker Color="{Binding OutlineColor, Mode=TwoWay}" Width="80" />
                                                </StackPanel>
                                                <TextBlock Text="{loc:Tr TouchButton_Width}" />
                                                <Grid ColumnDefinitions="*,50">
                                                    <Slider Grid.Column="0"
                                                            Minimum="0.5" Maximum="20"
                                                            Value="{Binding OutlineWidth, Mode=TwoWay}"
                                                            TickFrequency="0.5" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding OutlineWidth, StringFormat={}{0:0.0}}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Drop shadow -->
                                            <CheckBox Content="{loc:Tr TouchButton_Shadow}"
                                                      IsChecked="{Binding Shadow, Mode=TwoWay}"
                                                      Margin="0,2,0,0" />
                                            <StackPanel IsVisible="{Binding Shadow}" Margin="16,2,0,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="{loc:Tr TouchButton_Color2}" Width="50" VerticalAlignment="Center" />
                                                    <ccp:ColorPicker Color="{Binding ShadowColor, Mode=TwoWay}" Width="80" />
                                                </StackPanel>
                                                <TextBlock Text="{loc:Tr TouchButton_Blur}" />
                                                <Grid ColumnDefinitions="*,50">
                                                    <Slider Grid.Column="0"
                                                            Minimum="0" Maximum="20"
                                                            Value="{Binding ShadowBlur, Mode=TwoWay}"
                                                            TickFrequency="0.5" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ShadowBlur, StringFormat={}{0:0.0}}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{loc:Tr TouchButton_OffsetX}" />
                                                <Grid ColumnDefinitions="*,50">
                                                    <Slider Grid.Column="0"
                                                            Minimum="-20" Maximum="20"
                                                            Value="{Binding ShadowOffsetX, Mode=TwoWay}"
                                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ShadowOffsetX}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{loc:Tr TouchButton_OffsetY}" />
                                                <Grid ColumnDefinitions="*,50">
                                                    <Slider Grid.Column="0"
                                                            Minimum="-20" Maximum="20"
                                                            Value="{Binding ShadowOffsetY, Mode=TwoWay}"
                                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ShadowOffsetY}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>

                                            <Separator Margin="0,6,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Position}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding PositionX, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding PositionY, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_SizePx}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,0">
                                                <TextBlock Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding DisplayWidth, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="H" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding DisplayHeight, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Plugin layer: content is rendered by a plugin command
                                         (read-only); the user may move/scale/rotate/hide it. -->
                                    <DataTemplate DataType="layers:PluginLayer">
                                        <StackPanel>
                                            <TextBlock Classes="panel-title" Text="{loc:Tr TouchButton_SelectedLayerPlugin}" />

                                            <Border Background="{DynamicResource AppSurfaceLow}"
                                                    CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Classes="label" Text="{loc:Tr TouchButton_RenderedByPluginCommand}" />
                                                    <TextBlock Text="{Binding CommandName}"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               ToolTip.Tip="{Binding OwnerKey}" />
                                                    <TextBlock Classes="hint" Margin="0,4,0,0"
                                                               Text="{loc:Tr TouchButton_ContentIsOwnedByThe}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Name}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="0,2,0,8" />

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Position}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding PositionX, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding PositionY, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_SizePx}" />
                                            <Grid ColumnDefinitions="16,*,12,16,*" Margin="0,2,0,8">
                                                <TextBlock Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding DisplayWidth, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                                <TextBlock Grid.Column="3" Text="H" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <NumericUpDown Grid.Column="4"
                                                               Value="{Binding DisplayHeight, Mode=TwoWay}"
                                                               Minimum="1" Maximum="4000"
                                                               Increment="1" FormatString="0" />
                                            </Grid>

                                            <TextBlock Classes="label" Text="{loc:Tr TouchButton_Rotation}" />
                                            <Grid ColumnDefinitions="*,50" Margin="0,2,0,0">
                                                <Slider Grid.Column="0"
                                                        Minimum="0" Maximum="360"
                                                        Value="{Binding Rotation, Mode=TwoWay}"
                                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Rotation, StringFormat={}{0:0}°}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr TouchButton_Commands}">
                    <!-- Master-detail command picker (issue #171). The assigned sequence
                         lives in the pipeline strip at the bottom of the window; the
                         picker keeps its full height. Double-click an entry to append
                         it, or drag it into the strip. -->
                    <Border Classes="editor-panel" Margin="0,4,4,0">
                        <views:CommandPickerView Name="PickerControl"
                                                 DataContext="{Binding CommandPicker}" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===== Bottom: behavior for the selected state =====
             Panel with the title, the after-press transition (above), and the Actions /
             command sequence (one strip for a normal button, three top/middle/bottom segments
             for a FreeDraw side strip). Capped in height and scrollable inside, so a long
             sequence never squeezes the editor area out of a resized window. -->
        <Border Grid.Row="1" Classes="editor-panel" Margin="0,12,0,0" MaxHeight="320">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Classes="panel-title" Margin="0,0,0,8"
                               IsVisible="{Binding ShowStatesSection}"
                               Text="{loc:TrFormat Common_BehaviorForStateFmt, SelectedState.Name}" />

                    <!-- After-press transition — above the command sequence. Bound directly to the
                         selected state's transition so switching states never writes into the wrong one. -->
                    <StackPanel IsVisible="{Binding ShowStatesSection}" IsEnabled="{Binding CanEditStates}"
                                Margin="0,0,0,12">
                        <TextBlock Classes="label" Text="{loc:Tr TouchButton_TransitionAfterPress}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="220"
                                      ItemsSource="{Binding TransitionKinds}"
                                      SelectedItem="{Binding SelectedState.Transition.Kind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:StateTransitionKind">
                                        <TextBlock Text="{Binding Converter={StaticResource TransitionKindLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox MinWidth="220"
                                      IsVisible="{Binding SelectedState.Transition.Kind, Converter={StaticResource EnumToBoolean}, ConverterParameter=Specific}"
                                      ItemsSource="{Binding States}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding SelectedState.Transition.TargetStateId, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding Name}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Classes="label" Text="{loc:Tr TouchButton_ActionsCommandSequence}"
                               IsVisible="{Binding ShowStatesSection}" Margin="0,0,0,4" />

                    <ItemsControl Name="SlotsHost"
                                  ItemsSource="{Binding CommandSlots}"
                                  ItemTemplate="{StaticResource SequenceStripTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Drag ghost =====
             Floating chip that follows the cursor while dragging a command from
             the tree into the sequence strip. Spans the whole window, never hit-
             tests, and is positioned from code-behind during the drag. -->
        <Canvas Name="DragGhostLayer" Grid.Row="0" Grid.RowSpan="2"
                IsHitTestVisible="False" IsVisible="False">
            <!-- Insertion marker: vertical bar shown at the slot where the
                 dragged command will land. Positioned from code-behind. -->
            <Rectangle Name="DropMarker" Width="3"
                       Fill="#4DA3FF" RadiusX="1.5" RadiusY="1.5"
                       IsVisible="False" />
            <Border Name="DragGhost" Classes="drag-ghost">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="&#xF01DB;" FontFamily="{StaticResource MdiFont}"
                               FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMuted}" />
                    <TextBlock Name="DragGhostText" Classes="chip-title"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
