<Window
    x:Class="LoupixDeck.Views.SymbolPicker"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LoupixDeck.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LoupixDeck.ViewModels"
    xmlns:utils="using:LoupixDeck.Utils"
    x:DataType="vm:SymbolPickerViewModel"
    mc:Ignorable="d"
    Title="{loc:Tr SymbolPicker_ChooseSymbol}"
    Width="660"
    Height="600"
    WindowStartupLocation="CenterOwner"
    CanResize="False">
    <Border BorderThickness="2" BorderBrush="DarkGray" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Search + source + category filter -->
            <Grid Grid.Row="0" ColumnDefinitions="*,190,170" Margin="0,0,0,8">
                <TextBox Grid.Column="0"
                         PlaceholderText="{loc:Tr SymbolPicker_SearchSymbols}"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,8,0"
                          ToolTip.Tip="{loc:Tr SymbolPicker_SourceTip}"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SymbolSourceOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                    <!-- A virtualizing panel sizes the drop-down to the entries realized so far, so its
                         width jumps while scrolling the long tag list; measuring all entries keeps it stable. -->
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SymbolCategoryOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Symbol grid: a virtualized list of rows, so thousands of icons stay cheap -->
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource AppBorderSubtle}" Background="{DynamicResource AppSurfaceLow}">
                <ListBox x:Name="SymbolRows"
                         ItemsSource="{Binding Rows}"
                         Background="Transparent"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <!-- Rows are containers only; selection lives on the cells. -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="Border.symbol-cell">
                            <Setter Property="Width" Value="92" />
                            <Setter Property="Height" Value="92" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style Selector="Border.symbol-cell:pointerover">
                            <Setter Property="Background" Value="{DynamicResource AppControlBackgroundHover}" />
                        </Style>
                        <Style Selector="Border.symbol-cell.selected">
                            <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:SymbolRow">
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SymbolCell">
                                        <Border Classes="symbol-cell"
                                                Classes.selected="{Binding IsSelected}"
                                                Tapped="SymbolCell_Tapped"
                                                DoubleTapped="SymbolCell_DoubleTapped"
                                                ToolTip.Tip="{Binding Symbol.Id}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Symbol.Glyph}"
                                                           FontFamily="{Binding Symbol.FontFamily}"
                                                           FontSize="40"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Symbol.DisplayName}"
                                                           FontSize="11"
                                                           MaxHeight="30"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Text="{Binding SelectedSymbol.DisplayName, FallbackValue={x:Null}}"
                           IsVisible="{Binding SelectedSymbol, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Text="{Binding CountText}"
                           IsVisible="{Binding SelectedSymbol, Converter={x:Static ObjectConverters.IsNull}}" />
                <Button Grid.Column="1"
                        Content="{loc:Tr SymbolPicker_Cancel}"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2"
                        Content="{loc:Tr SymbolPicker_OK}"
                        MinWidth="110"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </Grid>
    </Border>
</Window>
