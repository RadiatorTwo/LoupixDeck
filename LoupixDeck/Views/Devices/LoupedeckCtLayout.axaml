<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LoupixDeck.Localization"
             xmlns:vm="using:LoupixDeck.ViewModels"
             xmlns:controls="using:LoupixDeck.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:LoupixDeck.Models.Converter"
             xmlns:models="clr-namespace:LoupixDeck.Models"
             xmlns:utils="clr-namespace:LoupixDeck.Utils"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d"
             x:Class="LoupixDeck.Views.Devices.LoupedeckCtLayout"
             x:DataType="vm:MainWindowViewModel"
             x:Name="RootControl">
    <!-- Loupedeck CT layout, positions matched against the real device photo
         (CT-Main-Top-Down-1). Geometry (4x3 touch grid + 2x60x270 side strips, same
         indices as the Razer Stream Controller) is shared, so the screen block below
         is copied from RazerStreamControllerLayout.axaml verbatim. Below the screen:
         - a row of 8 round LED buttons (SimpleButtons[0..7]).
         - a bottom cluster: a left 2x3 block of named buttons (Home/Enter, Undo/Save,
           Keyboard/FnL), the centre wheel, and a right 2x3 block (A/B, C/D, FnR/E),
           bound to SimpleButtons[8..19].
         - the centre "wheel" — the 7th rotary, with its own round touchscreen. Its
           binding is per touch page (TouchButtonPage.Wheel) rather than in the
           Left/Right per-strip rotary pages used by the 6 side dials. -->
    <UserControl.Styles>
        <!-- Rotary dials: hover/selection shown as a round ring following the knob shape. -->
        <Style Selector="Button.Knob">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Ellipse Name="HighlightRing" Margin="3" StrokeThickness="3"
                                 Stroke="Transparent" IsHitTestVisible="False"
                                 Classes.selected="{Binding ((models:LoupedeckButton)CommandParameter).IsSelected, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Knob:pointerover /template/ Ellipse#HighlightRing">
            <Setter Property="Stroke" Value="#803D9BFF" />
        </Style>
        <Style Selector="Button.Knob /template/ Ellipse#HighlightRing.selected">
            <Setter Property="Stroke" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>

        <!-- Round LED buttons: hover/selection shown as a round ring following the LED shape. -->
        <Style Selector="Button.LedRound">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Ellipse Name="HighlightRing" Margin="3" StrokeThickness="3"
                                 Stroke="Transparent" IsHitTestVisible="False"
                                 Classes.selected="{Binding ((models:LoupedeckButton)CommandParameter).IsSelected, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LedRound:pointerover /template/ Ellipse#HighlightRing">
            <Setter Property="Stroke" Value="#803D9BFF" />
        </Style>
        <Style Selector="Button.LedRound /template/ Ellipse#HighlightRing.selected">
            <Setter Property="Stroke" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>

        <!-- Square named buttons: same chrome-free treatment as the round LEDs, but the
             hover/selection highlight is a rounded rectangle following the square shape. -->
        <Style Selector="Button.LedSquare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border Name="HighlightBorder" Margin="3" CornerRadius="6"
                                BorderThickness="3" BorderBrush="Transparent"
                                IsHitTestVisible="False"
                                Classes.selected="{Binding ((models:LoupedeckButton)CommandParameter).IsSelected, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LedSquare:pointerover /template/ Border#HighlightBorder">
            <Setter Property="BorderBrush" Value="#803D9BFF" />
        </Style>
        <Style Selector="Button.LedSquare /template/ Border#HighlightBorder.selected">
            <Setter Property="BorderBrush" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>

        <Style Selector="Button[Tag=Touch]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <!-- Placeholder: the assigned command's name is filled in on opening (DeviceButtonToolTip). -->
            <Setter Property="ToolTip.Tip" Value=" " />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <!-- Hover / selection highlight, drawn inset over the tile so it clears
                             the surrounding device bezel. The selected state follows the bound
                             TouchButton's IsSelected (single click selects). -->
                        <Border Name="HighlightBorder"
                                Margin="5" CornerRadius="6"
                                BorderThickness="3" BorderBrush="Transparent"
                                IsHitTestVisible="False"
                                Classes.selected="{Binding ((models:LoupedeckButton)CommandParameter).IsSelected, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                        <!-- Editor-only hint (issue #306): the tile has a command but no visible layer, so
                             it would look unused. Never part of the rendered image sent to the device. -->
                        <Ellipse Name="CommandBadge"
                                 Width="10" Height="10" Margin="0,13,13,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{StaticResource PageActiveBorderBrush}"
                                 Stroke="#99000000" StrokeThickness="1.5"
                                 IsHitTestVisible="False"
                                 IsVisible="{Binding ((models:TouchButton)CommandParameter).ShowsCommandHint, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- MouseOver: a subtle border instead of the old zoom. -->
        <Style Selector="Button[Tag=Touch]:pointerover /template/ Border#HighlightBorder">
            <Setter Property="BorderBrush" Value="#803D9BFF" />
        </Style>
        <!-- Selected (single click): solid accent border; declared last so it wins over hover. -->
        <Style Selector="Button[Tag=Touch] /template/ Border#HighlightBorder.selected">
            <Setter Property="BorderBrush" Value="{StaticResource PageActiveBorderBrush}" />
        </Style>
        <!-- Leading icon of a pager, naming the control it pages (touch grid vs. wheel). -->
        <Style Selector="TextBlock.PagerIcon">
            <Setter Property="FontFamily" Value="{StaticResource MdiFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        </Style>
    </UserControl.Styles>

    <controls:DeviceZoomPanel BaseWidth="760" Zoom="{Binding ViewZoom}" HorizontalAlignment="Center"
                              Tapped="OnBackgroundTapped"
                              ContextRequested="OnButtonContextRequested">

        <!-- Independent rotary pagers for the 6 side dials (left/right columns), inset 65
             units from the body sides and ending 12px above the visible body top (SVG y=40). -->
        <Grid Margin="0,10,0,12" ZIndex="1"
              controls:DeviceZoomPanel.Edge="Top"
              controls:DeviceZoomPanel.AnchorY="40"
              controls:DeviceZoomPanel.InsetX="65">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Classes="Pager" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Classes="PagerBtn PagerNav" Content="‹"
                            ToolTip.Tip="{loc:Tr Device_PreviousLeftRotaryPage}"
                            Command="{Binding PreviousLeftRotaryPageCommand}" />
                    <TextBox Classes="PageName" Width="130"
                             Text="{Binding LoupedeckController.Config.CurrentLeftRotaryButtonPage.Name, Mode=TwoWay}"
                             PlaceholderText="{Binding LoupedeckController.Config.CurrentLeftRotaryButtonPage.PageName}"
                             KeyDown="OnPageNameKeyDown" LostFocus="OnPageNameCommit" />
                    <Button Classes="PagerBtn PagerNav" Content="›"
                            ToolTip.Tip="{loc:Tr Device_NextLeftRotaryPage}"
                            Command="{Binding NextLeftRotaryPageCommand}" />
                    <TextBlock Classes="PageCount"
                               Text="{Binding LoupedeckController.Config.LeftRotaryPageLabel}"
                               ToolTip.Tip="{loc:Tr Device_CurrentTotalLeftRotaryPages}" />
                    <Button Classes="PagerBtn" Content="+"
                            ToolTip.Tip="{loc:Tr Device_AddLeftRotaryPage}"
                            Command="{Binding AddLeftRotaryPageCommand}" />
                    <Button Classes="PagerBtn delete" Content="✕"
                            ToolTip.Tip="{loc:Tr Device_DeleteCurrentLeftRotaryPage}"
                            Command="{Binding DeleteLeftRotaryPageCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="Pager" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Classes="PagerBtn PagerNav" Content="‹"
                            ToolTip.Tip="{loc:Tr Device_PreviousRightRotaryPage}"
                            Command="{Binding PreviousRightRotaryPageCommand}" />
                    <TextBox Classes="PageName" Width="130"
                             Text="{Binding LoupedeckController.Config.CurrentRightRotaryButtonPage.Name, Mode=TwoWay}"
                             PlaceholderText="{Binding LoupedeckController.Config.CurrentRightRotaryButtonPage.PageName}"
                             KeyDown="OnPageNameKeyDown" LostFocus="OnPageNameCommit" />
                    <Button Classes="PagerBtn PagerNav" Content="›"
                            ToolTip.Tip="{loc:Tr Device_NextRightRotaryPage}"
                            Command="{Binding NextRightRotaryPageCommand}" />
                    <TextBlock Classes="PageCount"
                               Text="{Binding LoupedeckController.Config.RightRotaryPageLabel}"
                               ToolTip.Tip="{loc:Tr Device_CurrentTotalRightRotaryPages}" />
                    <Button Classes="PagerBtn" Content="+"
                            ToolTip.Tip="{loc:Tr Device_AddRightRotaryPage}"
                            Command="{Binding AddRightRotaryPageCommand}" />
                    <Button Classes="PagerBtn delete" Content="✕"
                            ToolTip.Tip="{loc:Tr Device_DeleteCurrentRightRotaryPage}"
                            Command="{Binding DeleteRightRotaryPageCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Device body (SVG placeholder) + control overlay. -->
        <Grid Width="900" Height="760" controls:DeviceZoomPanel.IsBody="True">

            <svg:Svg Path="{DynamicResource LoupedeckCtBodySvgPath}"
                     Stretch="Fill" Width="900" Height="760" />

            <Canvas Width="900" Height="760">

                <!-- ===== Screen block: identical geometry to Razer/Live (480x270 =
                     60 left strip + 4x3 grid + 60 right strip). ===== -->
                <Border Canvas.Left="194" Canvas.Top="114" Width="512" Height="302"
                        CornerRadius="22" ClipToBounds="True"
                        Background="{DynamicResource DeviceBezelBrush}">
                    <Grid>
                        <Grid Margin="16" ColumnDefinitions="60,360,60">
                            <Button Tag="Touch" Grid.Column="0" Width="60" Height="270"
                                    Tapped="OnButtonTapped" DoubleTapped="OnStripDoubleTapped"
                                    CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[12]}">
                                <Border CornerRadius="0" ClipToBounds="True">
                                    <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[12].RenderedImage}" />
                                </Border>
                            </Button>

                            <Grid Grid.Column="1" ColumnDefinitions="90,90,90,90" RowDefinitions="90,90,90">
                                <Button Tag="Touch" Grid.Row="0" Grid.Column="0" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[0]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[0].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="0" Grid.Column="1" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[1]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[1].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="0" Grid.Column="2" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[2]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[2].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="0" Grid.Column="3" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[3]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[3].RenderedImage}" />
                                    </Border>
                                </Button>

                                <Button Tag="Touch" Grid.Row="1" Grid.Column="0" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[4]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[4].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="1" Grid.Column="1" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[5]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[5].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="1" Grid.Column="2" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[6]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[6].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="1" Grid.Column="3" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[7]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[7].RenderedImage}" />
                                    </Border>
                                </Button>

                                <Button Tag="Touch" Grid.Row="2" Grid.Column="0" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[8]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[8].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="2" Grid.Column="1" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[9]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[9].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="2" Grid.Column="2" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[10]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[10].RenderedImage}" />
                                    </Border>
                                </Button>
                                <Button Tag="Touch" Grid.Row="2" Grid.Column="3" Width="90" Height="90"
                                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[11]}">
                                    <Border CornerRadius="0" ClipToBounds="True">
                                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[11].RenderedImage}" />
                                    </Border>
                                </Button>
                            </Grid>

                            <Button Tag="Touch" Grid.Column="2" Width="60" Height="270"
                                    Tapped="OnButtonTapped" DoubleTapped="OnStripDoubleTapped"
                                    CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[13]}">
                                <Border CornerRadius="0" ClipToBounds="True">
                                    <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.TouchButtons[13].RenderedImage}" />
                                </Border>
                            </Button>
                        </Grid>

                        <Path IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Fill="{DynamicResource DeviceBezelBrush}">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <RectangleGeometry Rect="0,0,512,302" />
                                    <RectangleGeometry Rect="20.5,20.5,51,261" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="80.5,20.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="170.5,20.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="260.5,20.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="350.5,20.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="80.5,110.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="170.5,110.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="260.5,110.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="350.5,110.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="80.5,200.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="170.5,200.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="260.5,200.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="350.5,200.5,81,81" RadiusX="6" RadiusY="6" />
                                    <RectangleGeometry Rect="440.5,20.5,51,261" RadiusX="6" RadiusY="6" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Grid>
                </Border>

                <!-- ===== Left/right side dials (3 each), same geometry as Razer. ===== -->
                <Button Classes="Knob" Canvas.Left="90" Canvas.Top="114" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentLeftRotaryButtonPage.RotaryButtons[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>
                <Button Classes="Knob" Canvas.Left="90" Canvas.Top="225" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentLeftRotaryButtonPage.RotaryButtons[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>
                <Button Classes="Knob" Canvas.Left="90" Canvas.Top="336" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentLeftRotaryButtonPage.RotaryButtons[2], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>

                <Button Classes="Knob" Canvas.Left="730" Canvas.Top="114" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentRightRotaryButtonPage.RotaryButtons[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>
                <Button Classes="Knob" Canvas.Left="730" Canvas.Top="225" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentRightRotaryButtonPage.RotaryButtons[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>
                <Button Classes="Knob" Canvas.Left="730" Canvas.Top="336" Width="80" Height="80"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentRightRotaryButtonPage.RotaryButtons[2], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="80" Height="80" />
                </Button>

                <!-- ===== 8 round LED buttons (SimpleButtons[0..7]). ===== -->
                <Button Tag="Led" Classes="LedRound" Canvas.Left="104" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[0]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[0].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="193" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[1]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[1].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="281" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[2]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[2].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="370" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[3]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[3].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="458" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[4]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[4].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="547" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[5]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[5].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="635" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[6]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[6].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedRound" Canvas.Left="724" Canvas.Top="437" Width="72" Height="72"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[7]}">
                    <Border Background="Transparent" Width="72" Height="72" CornerRadius="36">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[7].RenderedImage}" />
                    </Border>
                </Button>

                <!-- ===== Bottom control cluster, matching the real device photo:
                     a left 2x3 block of named buttons, the centre wheel, and a
                     right 2x3 block of named buttons — all in the same row band,
                     below the 8 round LEDs.
                     Left column order (top→bottom): Home/Enter, Undo/Save,
                     Keyboard/FnL. Right column order: A/B (up/down), C/D
                     (left/right), FnR/E. Matches BuildSimpleButtons' ctDefaults
                     order: [8]=Home [9]=Undo [10]=Keyboard [11]=Enter [12]=Save
                     [13]=FnL [14]=A [15]=B [16]=C [17]=D [18]=FnR [19]=E. ===== -->

                <!-- Left block. -->
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="170" Canvas.Top="520" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[8]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[8].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="250" Canvas.Top="520" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[11]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[11].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="170" Canvas.Top="585" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[9]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[9].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="250" Canvas.Top="585" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[12]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[12].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="170" Canvas.Top="650" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[10]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[10].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="250" Canvas.Top="650" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[13]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[13].RenderedImage}" />
                    </Border>
                </Button>

                <!-- Centre wheel: the 7th rotary (global index 6) + its own 240x240 round
                     touchscreen. Its binding lives on the current touch page
                     (TouchButtonPage.Wheel), so it follows touch-page switches; the
                     screen's last frame is mirrored inside the ring. -->
                <Button Classes="Knob" Canvas.Left="350" Canvas.Top="510" Width="200" Height="200"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        ToolTip.Tip="{loc:Tr Device_CentreWheel}"
                        CommandParameter="{Binding LoupedeckController.Config.CurrentTouchButtonPage.Wheel}">
                    <Grid>
                        <controls:DevicePreviewImage DeviceImage="{Binding RotaryKnobImage}" Width="200" Height="200" />
                        <Border Width="120" Height="120" CornerRadius="60" ClipToBounds="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.CurrentTouchButtonPage.Wheel.RenderedImage}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Right block. -->
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="580" Canvas.Top="520" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[14]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[14].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="660" Canvas.Top="520" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[15]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[15].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="580" Canvas.Top="585" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[16]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[16].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="660" Canvas.Top="585" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[17]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[17].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="580" Canvas.Top="650" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[18]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[18].RenderedImage}" />
                    </Border>
                </Button>
                <Button Tag="Led" Classes="LedSquare" Canvas.Left="660" Canvas.Top="650" Width="70" Height="55"
                        Tapped="OnButtonTapped" DoubleTapped="OnButtonDoubleTapped"
                        CommandParameter="{Binding LoupedeckController.Config.SimpleButtons[19]}">
                    <Border Background="Transparent" Width="70" Height="55" CornerRadius="6">
                        <controls:DevicePreviewImage DeviceImage="{Binding LoupedeckController.Config.SimpleButtons[19].RenderedImage}" />
                    </Border>
                </Button>
            </Canvas>

            <Border IsVisible="{Binding IsExclusiveModeActive}"
                    Background="#E60F0F0F"
                    BorderBrush="{StaticResource SelectedBrush}"
                    BorderThickness="2"
                    CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{loc:Tr Device_ExclusiveModeActive}"
                               FontSize="22" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ExclusiveModeTitle}"
                               FontSize="16" Foreground="#CCCCCC"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ExclusiveModeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{loc:Tr Device_TheDeviceIsBeingControlled}"
                               FontSize="12" Foreground="#999999"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Touch pages (the 12-key grid) and the centre wheel's modes of the current touch page,
             side by side, just under the visible body (SVG y=730); the leading icon says which
             control each pager belongs to. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,2,0,12"
                    controls:DeviceZoomPanel.Edge="Bottom"
                    controls:DeviceZoomPanel.AnchorY="730">
            <Panel VerticalAlignment="Center">
                <!-- While a custom folder is open its breadcrumbs take the pager's place. -->
                <controls:FolderBreadcrumbBar HorizontalAlignment="Center" IsVisible="{Binding IsFolderOpen}" />
                <Border Classes="Pager" HorizontalAlignment="Center" IsVisible="{Binding !IsFolderOpen}">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="PagerIcon" Text="&#xF11D9;"
                                   ToolTip.Tip="{loc:Tr Device_TouchPagesTitle}" />
                        <Button Classes="PagerBtn PagerNav" Content="‹"
                                ToolTip.Tip="{loc:Tr Device_PreviousTouchPage}"
                                Command="{Binding PreviousTouchPageCommand}" />
                        <TextBox Classes="PageName"
                                 Text="{Binding LoupedeckController.Config.CurrentTouchButtonPage.Name, Mode=TwoWay}"
                                 PlaceholderText="{Binding LoupedeckController.Config.CurrentTouchButtonPage.PageName}"
                                 KeyDown="OnPageNameKeyDown" LostFocus="OnPageNameCommit" />
                        <Button Classes="PagerBtn PagerNav" Content="›"
                                ToolTip.Tip="{loc:Tr Device_NextTouchPage}"
                                Command="{Binding NextTouchPageCommand}" />
                        <TextBlock Classes="PageCount"
                                   Text="{Binding LoupedeckController.Config.TouchPageLabel}"
                                   ToolTip.Tip="{loc:Tr Device_CurrentTotalTouchPages}" />
                        <Button Classes="PagerBtn" Content="+"
                                ToolTip.Tip="{loc:Tr Device_AddTouchPage}"
                                Command="{Binding AddTouchPageCommand}" />
                        <Button Classes="PagerBtn delete" Content="✕"
                                ToolTip.Tip="{loc:Tr Device_DeleteCurrentTouchPage}"
                                Command="{Binding DeleteTouchPageCommand}" />
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Centre-wheel modes of the current touch page. The name box edits the active mode's
                 label (what the wheel screen shows); double-click the wheel to edit its commands. -->
            <Border Classes="Pager" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="PagerIcon" Text="&#xF1B96;"
                               ToolTip.Tip="{loc:Tr Device_WheelModesTitle}" />
                    <Button Classes="PagerBtn PagerNav" Content="‹"
                            ToolTip.Tip="{loc:Tr Device_PreviousWheelMode}"
                            Command="{Binding PreviousWheelModeCommand}" />
                    <TextBox Classes="PageName" Width="130"
                             Text="{Binding LoupedeckController.Config.CurrentTouchButtonPage.Wheel.DisplayText, Mode=TwoWay}"
                             PlaceholderText="{loc:Tr Device_WheelModeLabelPlaceholder}"
                             KeyDown="OnWheelLabelKeyDown" LostFocus="OnWheelLabelCommit" />
                    <Button Classes="PagerBtn PagerNav" Content="›"
                            ToolTip.Tip="{loc:Tr Device_NextWheelMode}"
                            Command="{Binding NextWheelModeCommand}" />
                    <TextBlock Classes="PageCount"
                               Text="{Binding LoupedeckController.Config.CurrentTouchButtonPage.WheelModeLabel}"
                               ToolTip.Tip="{loc:Tr Device_CurrentTotalWheelModes}" />
                    <Button Classes="PagerBtn" Content="&#xF0E8A;" FontFamily="{StaticResource MdiFont}"
                            ToolTip.Tip="{loc:Tr Device_EditWheelAppearance}"
                            Command="{Binding EditWheelCanvasCommand}" />
                    <Button Classes="PagerBtn" Content="+"
                            ToolTip.Tip="{loc:Tr Device_AddWheelMode}"
                            Command="{Binding AddWheelModeCommand}" />
                    <Button Classes="PagerBtn delete" Content="✕"
                            ToolTip.Tip="{loc:Tr Device_DeleteWheelMode}"
                            Command="{Binding DeleteWheelModeCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

    </controls:DeviceZoomPanel>
</UserControl>
