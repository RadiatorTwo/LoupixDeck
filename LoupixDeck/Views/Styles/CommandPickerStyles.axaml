<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Command picker (issue #171, master-detail redesign) =====
         A dark, two-pane command selection panel: a slim group rail on the left
         (sections → categories) and the command list of the selected group on the
         right, over the panel's full height (search → group header → list → footer).
         Selection is driven by the view-model (bound `.selected` classes); keyboard
         focus is a separate blue outline so it never reads as selection. -->

    <!-- Search bar shortcut hint pill ("Ctrl K"). -->
    <Style Selector="Border.picker-kbd">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-kbd TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
    </Style>

    <!-- ===== Group rail (left pane) ===== -->
    <!-- Recessed against the detail pane so the two halves read as separate columns. -->
    <Style Selector="Border.picker-rail">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Width" Value="172" />
    </Style>

    <!-- Section caption above a run of rail items ("CORE", "MACROS", "PLUGINS"). -->
    <Style Selector="TextBlock.picker-rail-caption">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="Margin" Value="10,10,10,6" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- One group entry in the rail. The clickable wrapper is a chromeless Button
         (gives focus, Enter/Space, Tab); its inner face carries the visuals. -->
    <Style Selector="Button.picker-rail-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.picker-rail-item /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Left accent edge is always reserved (constant thickness) so selecting an
         entry tints it instead of shifting the row's content sideways. -->
    <Style Selector="Border.picker-rail-face">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.picker-rail-item:pointerover Border.picker-rail-face">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>
    <Style Selector="Button.picker-rail-item:focus-visible Border.picker-rail-face">
        <Setter Property="BorderBrush" Value="{DynamicResource PickerFocusBrush}" />
    </Style>
    <!-- Selected: violet accent edge + tint. Declared last so it wins over hover. -->
    <Style Selector="Border.picker-rail-face.selected">
        <Setter Property="Background" Value="{DynamicResource PickerAccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PickerAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.picker-rail-icon">
        <Setter Property="FontFamily" Value="{DynamicResource MdiFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="22" />
    </Style>
    <Style Selector="Border.picker-rail-face.selected TextBlock.picker-rail-icon">
        <Setter Property="Foreground" Value="{DynamicResource PickerAccentBorderBrush}" />
    </Style>

    <Style Selector="TextBlock.picker-rail-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.picker-rail-face.selected TextBlock.picker-rail-title">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Command count, right-aligned as a plain number (no pill: the rail is narrow). -->
    <Style Selector="TextBlock.picker-rail-count">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.picker-rail-face.selected TextBlock.picker-rail-count">
        <Setter Property="Foreground" Value="{DynamicResource PickerAccentBorderBrush}" />
    </Style>

    <!-- ===== Detail header (group title + command count) ===== -->
    <Style Selector="Border.picker-detail-header">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7,20,6" />
    </Style>
    <Style Selector="TextBlock.picker-detail-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PickerAccentBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.picker-detail-count">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Search-result group caption (one per source folder path). -->
    <Style Selector="TextBlock.picker-result-group">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.picker-result-header">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <!-- Extra right inset: same overlay-scrollbar gutter as the group count. -->
        <Setter Property="Padding" Value="10,4,20,4" />
    </Style>
    <Style Selector="Border.picker-result-header TextBlock.picker-rail-icon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="18" />
    </Style>

    <!-- ===== Group node (inline accordion header inside the detail list) ===== -->
    <!-- A chromeless full-width ToggleButton; IsChecked is bound to IsExpanded, so a
         mouse click or Enter/Space toggles the group. Sits at the same density as the
         command rows so the list reads as one column, never as a TreeView. -->
    <Style Selector="ToggleButton.picker-group">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderFaint}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <!-- Content inset (including the overlay-scrollbar gutter) lives on
             the inner grid. Padding here is unused: the ContentPresenter
             padding is forced to 0 so hover/checked fill the full row. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.picker-group /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ToggleButton.picker-group:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>
    <Style Selector="ToggleButton.picker-group:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>
    <Style Selector="ToggleButton.picker-group:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource PickerFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Expand/collapse chevron: right when collapsed, down when expanded (glyph swap,
         mirroring the card-expand ToggleButton — no rotation converter in the project). -->
    <Style Selector="ToggleButton.picker-group TextBlock.picker-group-chevron">
        <Setter Property="FontFamily" Value="{DynamicResource MdiFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Text" Value="&#xF0142;" />
        <!-- mdi-chevron-right -->
    </Style>
    <Style Selector="ToggleButton.picker-group:checked TextBlock.picker-group-chevron">
        <Setter Property="Text" Value="&#xF0140;" />
        <!-- mdi-chevron-down -->
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
    </Style>

    <Style Selector="ToggleButton.picker-group TextBlock.picker-group-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Count badge on an accordion group header. -->
    <Style Selector="Border.picker-count">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-count TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ===== Command row ===== -->
    <!-- A dense two-line row: title over description across the row's full width (the
         insertion button sits in the footer, not on the row). The selection marker is a
         2px accent edge running the row's full height; its thickness is always reserved
         so selecting a row tints it instead of shifting the content sideways. -->
    <Style Selector="Border.picker-row-face">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <!-- Extra right inset matches the group-header gutter so row text
             stays clear of the overlay scrollbar. -->
        <Setter Property="Padding" Value="12,9,20,9" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.picker-row-face:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>
    <Style Selector="Border.picker-row-face:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource PickerFocusBrush}" />
    </Style>
    <!-- Selected row: subtle violet tint + accent edge (declared last so it wins over hover). -->
    <Style Selector="Border.picker-row-face.selected">
        <Setter Property="Background" Value="{DynamicResource PickerAccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PickerAccentBrush}" />
    </Style>

    <!-- Explicit line heights keep the two-line row at a fixed 50 px regardless of the
         font's own metrics. -->
    <Style Selector="TextBlock.picker-row-title">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.picker-row-desc">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- "Group" pill on a rotary command-group row (violet accent, matching selection). -->
    <Style Selector="Border.picker-group-badge">
        <Setter Property="Background" Value="{DynamicResource PickerAccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PickerAccentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-group-badge TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PickerAccentBorderBrush}" />
    </Style>

    <!-- ===== Footer: selected command + insertion button ===== -->
    <!-- Separated from the last row by a small gap, so the divider reads as the panel's
         base line rather than as another row separator. -->
    <Style Selector="Border.picker-footer">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Padding" Value="14,7,10,7" />
    </Style>
    <!-- Names the row the button acts on; truncates rather than pushing the button out. -->
    <Style Selector="TextBlock.picker-footer-text">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- "Add" pill: the explicit affordance for the double-click / Enter insertion.
         Disabled while no command is selected. -->
    <Style Selector="Button.picker-footer-add">
        <Setter Property="Background" Value="{DynamicResource PickerAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.picker-footer-add /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PickerAccentBrush}" />
    </Style>
    <Style Selector="Button.picker-footer-add:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PickerAccentBorderBrush}" />
    </Style>
    <Style Selector="Button.picker-footer-add:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppTextMuted}" />
    </Style>

</Styles>
