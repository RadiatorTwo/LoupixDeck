<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LoupixDeck.Localization"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cnv="clr-namespace:LoupixDeck.Models.Converter"
        xmlns:controls="using:LoupixDeck.Views.Controls">

    <!-- ===== Custom window chrome =====
         A window that wears Classes="app-chrome" and puts its content inside an AppWindowFrame
         draws its own title bar instead of the OS one. -->
    <Style Selector="Window.app-chrome">
        <!-- No platform decorations and none drawn by Avalonia either: AppWindowFrame supplies
             the title bar, the caption buttons and the resize edges, and marks each of them
             with a WindowDecorationProperties.ElementRole so the platform still handles
             snapping, the resize cursors and the Windows snap-layout flyout.

             Avalonia 12 replaced ExtendClientAreaChromeHints with this role model. Do not
             reintroduce that property, and do not set ExtendClientAreaToDecorationsHint here -
             extending the client area makes Avalonia draw a title bar of its own on top of
             ours. -->
        <Setter Property="WindowDecorations" Value="None" />
    </Style>

    <Styles.Resources>
        <cnv:EnumToBooleanConverter x:Key="ChromeEnumToBoolean" />

        <ControlTheme x:Key="{x:Type controls:AppWindowFrame}" TargetType="controls:AppWindowFrame">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Classes="title-bar"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="title-bar-label"
                                               Margin="12,0,12,0"
                                               Text="{TemplateBinding Title}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <!-- mdi-window-minimize -->
                                        <Button Classes="title-bar-button" Content="&#xF05B0;"
                                                chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                                                IsVisible="{TemplateBinding ShowMinimize}"
                                                ToolTip.Tip="{loc:Tr Window_Minimize}" />

                                        <!-- The maximise and restore glyphs are two buttons that
                                             take turns, so the window state needs no code. -->
                                        <!-- mdi-window-maximize -->
                                        <Button Classes="title-bar-button" Content="&#xF05AF;"
                                                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                                                ToolTip.Tip="{loc:Tr Window_Maximize}">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <TemplateBinding Property="ShowMaximize" />
                                                    <Binding Path="$parent[Window].WindowState"
                                                             Converter="{StaticResource ChromeEnumToBoolean}"
                                                             ConverterParameter="Normal" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>
                                        <!-- mdi-window-restore -->
                                        <Button Classes="title-bar-button" Content="&#xF05B2;"
                                                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                                                ToolTip.Tip="{loc:Tr Window_Restore}">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <TemplateBinding Property="ShowMaximize" />
                                                    <Binding Path="$parent[Window].WindowState"
                                                             Converter="{StaticResource ChromeEnumToBoolean}"
                                                             ConverterParameter="Maximized" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <!-- mdi-close -->
                                        <Button Classes="title-bar-button close" Content="&#xF0156;"
                                                chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                                ToolTip.Tip="{loc:Tr Window_Close}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1" Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>

                        <!-- Resize edges. Four pixels is about what an OS frame offers too; the
                             corners are eight so they stay catchable. -->
                        <Grid ColumnDefinitions="8,*,8" RowDefinitions="8,*,8">
                            <Border Grid.Row="0" Grid.Column="0" Background="Transparent"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
                            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Height="4"
                                    VerticalAlignment="Top"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeN" />
                            <Border Grid.Row="0" Grid.Column="2" Background="Transparent"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeNE" />
                            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Width="4"
                                    HorizontalAlignment="Left"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeW" />
                            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Width="4"
                                    HorizontalAlignment="Right"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeE" />
                            <Border Grid.Row="2" Grid.Column="0" Background="Transparent"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
                            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Height="4"
                                    VerticalAlignment="Bottom"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeS" />
                            <Border Grid.Row="2" Grid.Column="2" Background="Transparent"
                                    chrome:WindowDecorationProperties.ElementRole="ResizeSE" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Border.title-bar">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderFaint}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="TextBlock.title-bar-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Caption button: chromeless until hovered, sized like the OS ones so the row still reads
         as a title bar. -->
    <Style Selector="Button.title-bar-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MdiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.title-bar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppControlBackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
    </Style>
    <Style Selector="Button.title-bar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppControlBackgroundActive}" />
    </Style>

    <!-- Close keeps the platform-conventional red hover so it stays recognisable. -->
    <Style Selector="Button.title-bar-button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.title-bar-button.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#A32218" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
