<Window
    x:Class="LoupixDeck.Views.AppPicker"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LoupixDeck.ViewModels"
    x:DataType="vm:AppPickerViewModel"
    mc:Ignorable="d"
    Title="Choose Application"
    Width="560"
    Height="640"
    WindowStartupLocation="CenterOwner"
    CanResize="True">
    <Border BorderThickness="2" BorderBrush="DarkGray" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Header: how many were found -->
            <TextBlock Grid.Row="0"
                       Text="{Binding CountLabel}"
                       Foreground="{DynamicResource AppTextSecondary}"
                       Margin="2,0,0,8" />

            <!-- Search -->
            <TextBox Grid.Row="1"
                     PlaceholderText="Search applications…"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     IsEnabled="{Binding ShowContent}"
                     Margin="0,0,0,8" />

            <!-- List, with the loading and empty states layered over it -->
            <Border Grid.Row="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderSubtle}"
                    Background="{DynamicResource AppSurfaceLow}">
                <Panel>
                    <!-- A plain ListBox keeps Avalonia's default VirtualizingStackPanel, which
                         matters here: a machine can easily have several hundred applications. -->
                    <ListBox ItemsSource="{Binding Apps}"
                             SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                             DoubleTapped="AppList_DoubleTapped"
                             IsVisible="{Binding ShowContent}"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:AppRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Margin="10,6"
                                      ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            CornerRadius="6"
                                            Background="{DynamicResource AppSurfaceLow}">
                                        <Image Source="{Binding Icon}" Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            IsVisible="{Binding IsGame}"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Background="{DynamicResource AppSurfaceLow}">
                                        <TextBlock Text="Game"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Searching for installed applications…"
                               IsVisible="{Binding IsLoading}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondary}" />

                    <TextBlock Text="{Binding BlockReason}"
                               IsVisible="{Binding HasBlockReason}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="380"
                               Foreground="{DynamicResource AppTextSecondary}" />
                </Panel>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Text="{Binding SelectedApp.Name}" />
                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="110"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2"
                        Content="Assign"
                        Width="110"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </Grid>
    </Border>
</Window>