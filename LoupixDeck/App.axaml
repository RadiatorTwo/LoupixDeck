<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoupixDeck.App"
             xmlns:local="using:LoupixDeck"
             xmlns:converter="using:LoupixDeck.Models.Converter"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- App-chrome surfaces resolve through theme-aware brushes so the whole UI
             follows Light/Dark. The simulated device (Views/Devices/*) intentionally
             stays dark regardless of theme — it represents black hardware. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppWindowBackground}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AppControlBackgroundHover}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="NumericUpDown:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AppControlBackgroundHover}" />
        </Style>
        <Style Selector="NumericUpDown:focus /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Theme-aware app-chrome palette =====
                 Neutral surfaces/borders/text for the application UI (windows,
                 settings, dialogs, pagers, macro editor). Accent (blue) and status
                 colours (red/green) are intentionally theme-invariant literals — they
                 read fine on both Light and Dark. The simulated-device chrome (touch
                 frame/body/screen) follows the theme via the Device* brushes in each
                 theme dictionary; the LED/knob plastic is rendered theme-aware in
                 BitmapHelper. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#141414" />
                    <SolidColorBrush x:Key="AppSurfaceLow" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="AppSurface" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="AppSurfaceAlt" Color="#343434" />
                    <SolidColorBrush x:Key="AppControlBackground" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="AppControlBackgroundHover" Color="#4C4C4C" />
                    <SolidColorBrush x:Key="AppControlBackgroundActive" Color="#464646" />
                    <SolidColorBrush x:Key="AppBorderSubtle" Color="#525252" />
                    <!-- A step quieter than AppBorderSubtle: outlines and dividers that must
                         read as a hairline rather than as a frame (header switcher, pagers). -->
                    <SolidColorBrush x:Key="AppBorderFaint" Color="#3A3A3A" />
                    <!-- Fill for the header bars (context switcher, pagers): only just lifted
                         off AppSurfaceLow so the bars settle into the toolbar. -->
                    <SolidColorBrush x:Key="AppSurfaceBar" Color="#101010" />
                    <!-- Touch-button editor canvas: deliberately lighter than the app
                         surfaces so a black button stays clearly visible. -->
                    <SolidColorBrush x:Key="AppEditorCanvasBackground" Color="#3E4146" />
                    <!-- Subtle accent tint behind an active/selected slot (pairs with the
                         theme-invariant blue accent border). -->
                    <SolidColorBrush x:Key="AppAccentSubtle" Color="#26354A" />
                    <!-- Violet tint behind a selected command-picker card (pairs with
                         the theme-invariant violet accent border). -->
                    <SolidColorBrush x:Key="PickerAccentSubtle" Color="#2E2342" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#ABABAB" />
                    <!-- Status colours used as small dots and as link/label text (plugins
                         list, store tiles). The pill fills in SettingsStyles are dark-only
                         literals; these have to read on a light card too, so they are
                         theme-aware. -->
                    <SolidColorBrush x:Key="StatusDotOk" Color="#5FCF85" />
                    <SolidColorBrush x:Key="StatusDotWarn" Color="#E2C37A" />
                    <SolidColorBrush x:Key="StatusDotNeutral" Color="#9BA1A6" />
                    <SolidColorBrush x:Key="StatusDotInactive" Color="#7C8287" />
                    <SolidColorBrush x:Key="AppTextDestructive" Color="#E39494" />
                    <!-- Accent colours used as TEXT rather than as a border. The
                         PageActive/PickerAccent border brushes are theme-invariant and far
                         too pale to read as a label on a light surface, so labels and links
                         use these instead. -->
                    <SolidColorBrush x:Key="AppAccentText" Color="#3D9BFF" />
                    <SolidColorBrush x:Key="PickerAccentText" Color="#A78BFA" />
                    <SolidColorBrush x:Key="NoticeWarnBackground" Color="#332A14" />
                    <SolidColorBrush x:Key="NoticeWarnBorder" Color="#6B5A2D" />
                    <!-- Companion hint under the device selector ("Follows <master>"). -->
                    <SolidColorBrush x:Key="CompanionHintForeground" Color="#D9A05B" />
                    <!-- Simulated-device chrome (the dark hardware in Dark mode). -->
                    <SolidColorBrush x:Key="DeviceScreenBackground" Color="#0F0F0F" />
                    <SolidColorBrush x:Key="DeviceButtonBorder" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="DeviceBodyBrush" Color="#121212" />
                    <!-- Screen bezel/recess + seam frame around the touch grid. -->
                    <LinearGradientBrush x:Key="DeviceBezelBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#101114" />
                        <GradientStop Offset="1" Color="#16181d" />
                    </LinearGradientBrush>
                    <!-- Baked body artwork chosen per theme (see tools/BodyTextureBaker). -->
                    <x:String x:Key="DeviceBodySvgPath">avares://LoupixDeck/Assets/loupedeck-gehaeuse.svg</x:String>
                    <x:String x:Key="RazerBodySvgPath">avares://LoupixDeck/Assets/razer-gehaeuse.svg</x:String>
                    <x:String x:Key="LoupedeckCtBodySvgPath">avares://LoupixDeck/Assets/loupedeck-ct-gehaeuse.svg</x:String>
                    <x:String x:Key="RazerXBodySvgPath">avares://LoupixDeck/Assets/razer-x-gehaeuse.svg</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AppSurfaceLow" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceAlt" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppControlBackground" Color="#FFFFFF" />
                    <!-- Darker than every light surface they can sit on, not lighter. The old
                         values were #EDEDED / #DADADA, which vanished on AppSurfaceLow (#DCDCDC) -
                         the sidebar and every list built on it had a selection nobody could see. -->
                    <SolidColorBrush x:Key="AppControlBackgroundHover" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="AppControlBackgroundActive" Color="#B5B5B5" />
                    <SolidColorBrush x:Key="AppBorderSubtle" Color="#C4C4C4" />
                    <!-- A step quieter than AppBorderSubtle: outlines and dividers that must
                         read as a hairline rather than as a frame (header switcher, pagers). -->
                    <SolidColorBrush x:Key="AppBorderFaint" Color="#D8D8D8" />
                    <!-- Fill for the header bars (context switcher, pagers): only just lifted
                         off AppSurfaceLow so the bars settle into the toolbar. -->
                    <SolidColorBrush x:Key="AppSurfaceBar" Color="#E2E2E2" />
                    <!-- Touch-button editor canvas: deliberately lighter than the app
                         surfaces so a black button stays clearly visible. -->
                    <SolidColorBrush x:Key="AppEditorCanvasBackground" Color="#DCDEE2" />
                    <!-- Subtle accent tint behind an active/selected slot (pairs with the
                         theme-invariant blue accent border). -->
                    <SolidColorBrush x:Key="AppAccentSubtle" Color="#D6E8FB" />
                    <!-- Violet tint behind a selected command-picker card (pairs with
                         the theme-invariant violet accent border). -->
                    <SolidColorBrush x:Key="PickerAccentSubtle" Color="#EDE7FB" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="#111111" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#585858" />
                    <!-- Same roles as in Dark, darkened so they stay legible on a light card. -->
                    <SolidColorBrush x:Key="StatusDotOk" Color="#196B3C" />
                    <SolidColorBrush x:Key="StatusDotWarn" Color="#7A5200" />
                    <SolidColorBrush x:Key="StatusDotNeutral" Color="#666666" />
                    <SolidColorBrush x:Key="StatusDotInactive" Color="#8F8F8F" />
                    <SolidColorBrush x:Key="AppTextDestructive" Color="#B3261E" />
                    <!-- Same roles as in Dark, darkened so they read as text on a light surface. -->
                    <SolidColorBrush x:Key="AppAccentText" Color="#155FA8" />
                    <SolidColorBrush x:Key="PickerAccentText" Color="#6D3FD4" />
                    <SolidColorBrush x:Key="NoticeWarnBackground" Color="#FBF3DE" />
                    <SolidColorBrush x:Key="NoticeWarnBorder" Color="#D9BE79" />
                    <!-- Companion hint under the device selector ("Follows <master>"). -->
                    <SolidColorBrush x:Key="CompanionHintForeground" Color="#8A4F16" />
                    <!-- Simulated-device chrome rendered as light hardware in Light mode. -->
                    <SolidColorBrush x:Key="DeviceScreenBackground" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="DeviceButtonBorder" Color="#A8A8A8" />
                    <SolidColorBrush x:Key="DeviceBodyBrush" Color="#D6D6D6" />
                    <!-- Screen bezel/recess + seam frame, rendered as a light recessed frame. -->
                    <LinearGradientBrush x:Key="DeviceBezelBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#C2C2C2" />
                        <GradientStop Offset="1" Color="#B0B0B0" />
                    </LinearGradientBrush>
                    <!-- Baked body artwork chosen per theme (see tools/BodyTextureBaker). -->
                    <x:String x:Key="DeviceBodySvgPath">avares://LoupixDeck/Assets/loupedeck-gehaeuse-light.svg</x:String>
                    <x:String x:Key="RazerBodySvgPath">avares://LoupixDeck/Assets/razer-gehaeuse-light.svg</x:String>
                    <x:String x:Key="LoupedeckCtBodySvgPath">avares://LoupixDeck/Assets/loupedeck-ct-gehaeuse-light.svg</x:String>
                    <x:String x:Key="RazerXBodySvgPath">avares://LoupixDeck/Assets/razer-x-gehaeuse-light.svg</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converter:SKBitmapToAvaloniaBitmapConverter x:Key="SkiaToBitmapConverter" />
            <converter:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <FontFamily x:Key="MdiFont">avares://LoupixDeck/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons</FontFamily>

            <!-- Device-chrome accents (theme-invariant): mark selected/unselected
                 simulated device buttons. -->
            <SolidColorBrush x:Key="UnselectedBrush" Color="#FF4b4b4b" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF373737" />

            <!-- Accent used to mark the active page chip in the page toolbar. A clear,
                 saturated blue so the current page reads at a glance. Theme-invariant. -->
            <SolidColorBrush x:Key="PageActiveBrush" Color="#FF2F7DD1" />
            <SolidColorBrush x:Key="PageActiveBorderBrush" Color="#FF3D9BFF" />
            <SolidColorBrush x:Key="PageChipBorderBrush" Color="#FF454545" />

            <!-- Command-picker accent (violet, theme-invariant): marks the selected
                 category card and command row. Keyboard focus uses the separate blue
                 PickerFocusBrush so focus never reads as selection (issue #171). -->
            <SolidColorBrush x:Key="PickerAccentBrush" Color="#FF8B5CF6" />
            <SolidColorBrush x:Key="PickerAccentBorderBrush" Color="#FFA78BFA" />
            <SolidColorBrush x:Key="PickerFocusBrush" Color="#FF4DA3FF" />

            <DropShadowEffect x:Key="InnerShadow"
                              Color="#77000000"
                              BlurRadius="8"
                              OffsetX="0"
                              OffsetY="2"
                              Opacity="1" />
        </ResourceDictionary>
    </Application.Resources>
</Application>